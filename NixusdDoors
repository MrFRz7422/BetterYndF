	local State = {
		DoorList = {},
		EntityList = {},
		OriginalFog = Lighting.FogEnd,
		OriginalBrightness = Lighting.Brightness,
	}

	-- clean old ESP
	pcall(function()
		local old = CoreGui:FindFirstChild("NIXUS_ESP")
		if old then old:Destroy() end
	end)

	local ESPFolder = Instance.new("Folder")
	ESPFolder.Name = "NIXUS_ESP"
	ESPFolder.Parent = CoreGui

	local function clearESP()
		for _, c in ipairs(ESPFolder:GetChildren()) do
			c:Destroy()
		end
	end

	local function makeBillboard(adornee, text, color)
		local bb = Instance.new("BillboardGui")
		bb.Adornee = adornee
		bb.Size = UDim2.new(0, 140, 0, 28)
		bb.StudsOffset = Vector3.new(0, 2.8, 0)
		bb.AlwaysOnTop = true
		bb.Parent = ESPFolder

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 0.3
		lbl.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		lbl.Text = text
		lbl.TextColor3 = color
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 12
		lbl.Parent = bb

		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 4)
		corner.Parent = lbl
	end

	function refreshLists()
		State.DoorList = {}
		for _, obj in ipairs(workspace:GetDescendants()) do
			local n = string.lower(obj.Name)
			if (string.find(n, "door") or string.find(n, "gate") or string.find(n, "entrance"))
				and (obj:IsA("BasePart") or obj:IsA("Model") or obj:IsA("Folder")) then
				table.insert(State.DoorList, obj)
			end
		end
		Library:Notify("Doors found: " .. #State.DoorList, 3)
	end

	-- safe fire prompt
	local function safeFirePrompt(prompt)
		if not prompt then return end
		pcall(function()
			if fireproximityprompt then
				fireproximityprompt(prompt)
			else
				prompt:InputHoldBegin()
				task.wait(0.05)
				prompt:InputHoldEnd()
			end
		end)
	end

	-- ===================== ESP LOOP =====================
	RunService.RenderStepped:Connect(function()
		clearESP()
		if Toggles.PlayerESP and Toggles.PlayerESP.Value then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr ~= LP and plr.Character then
					local root = plr.Character:FindFirstChild("HumanoidRootPart")
					if root then
						makeBillboard(root, plr.Name, Color3.fromRGB(100, 180, 255))
					end
				end
			end
		end
		if Toggles.DoorESP and Toggles.DoorESP.Value then
			for _, d in ipairs(State.DoorList) do
				local part = d:IsA("BasePart") and d or d:FindFirstChildWhichIsA("BasePart", true)
				if part then
					makeBillboard(part, d.Name, Color3.fromRGB(100, 255, 140))
				end
			end
		end
		if Toggles.EntityESP and Toggles.EntityESP.Value then
			for _, ent in ipairs(State.EntityList) do
				if ent and ent.Parent then
					local part = ent:IsA("BasePart") and ent or ent:FindFirstChildWhichIsA("BasePart", true)
					if part then
						makeBillboard(part, ent.Name, Color3.fromRGB(255, 80, 80))
					end
				end
			end
		end
	end)

	-- ===================== MOVEMENT LOOPS =====================
	-- Lock Speed
	task.spawn(function()
		while task.wait(0.1) do
			if Toggles.LockSpeed and Toggles.LockSpeed.Value then
				pcall(function()
					local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
					if hum and Options.WalkSpeed then
						hum.WalkSpeed = Options.WalkSpeed.Value
					end
				end)
			end
		end
	end)

	-- Inf Jump
	UserInputService.JumpRequest:Connect(function()
		if Toggles.InfJump and Toggles.InfJump.Value then
			pcall(function()
				local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
				if hum then
					hum:ChangeState(Enum.HumanoidStateType.Jumping)
				end
			end)
		end
	end)

	-- Noclip
	RunService.Stepped:Connect(function()
		if Toggles.Noclip and Toggles.Noclip.Value then
			pcall(function()
				local char = LP.Character
				if char then
					for _, part in ipairs(char:GetDescendants()) do
						if part:IsA("BasePart") then
							part.CanCollide = false
						end
					end
				end
			end)
		end
	end)

	-- ===================== LIGHTING =====================
	local function applyLighting()
		pcall(function()
			if Toggles.Fullbright and Toggles.Fullbright.Value then
				Lighting.Brightness = 2
				Lighting.ClockTime = 14
				Lighting.FogEnd = 100000
				Lighting.GlobalShadows = false
				Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
			else
				Lighting.Brightness = State.OriginalBrightness
				Lighting.FogEnd = State.OriginalFog
				Lighting.GlobalShadows = true
			end
			if (Toggles.NoFog and Toggles.NoFog.Value) or (Toggles.RemoveDarkness and Toggles.RemoveDarkness.Value) then
				Lighting.FogEnd = 100000
				Lighting.FogStart = 0
			end
		end)
	end

	task.spawn(function()
		while task.wait(0.5) do
			applyLighting()
		end
	end)

	-- ===================== GODMODE =====================
	task.spawn(function()
		while task.wait(0.15) do
			if Toggles.Godmode and Toggles.Godmode.Value then
				pcall(function()
					local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
					if hum then
						hum.Health = hum.MaxHealth
					end
				end)
			end
		end
	end)

	-- ===================== INSTANT INTERACT =====================
	task.spawn(function()
		while task.wait(0.4) do
			if Toggles.InstantInteract and Toggles.InstantInteract.Value then
				pcall(function()
					for _, prompt in ipairs(workspace:GetDescendants()) do
						if prompt:IsA("ProximityPrompt") then
							prompt.HoldDuration = 0
							if prompt.MaxActivationDistance < 15 then
								prompt.MaxActivationDistance = 15
							end
						end
					end
				end)
			end
		end
	end)

	-- ===================== AUTO LOOT =====================
	task.spawn(function()
		while task.wait(0.4) do
			if Toggles.AutoLoot and Toggles.AutoLoot.Value then
				pcall(function()
					local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
					if not root then return end
					for _, obj in ipairs(workspace:GetDescendants()) do
						local n = string.lower(obj.Name)
						if string.find(n, "gold") or string.find(n, "coin") or string.find(n, "loot")
							or string.find(n, "key") or string.find(n, "bandage") or string.find(n, "candle")
							or string.find(n, "crucifix") or string.find(n, "lighter") then
							local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
							if part and (part.Position - root.Position).Magnitude < 25 then
								for _, p in ipairs(obj:GetDescendants()) do
									if p:IsA("ProximityPrompt") then
										p.HoldDuration = 0
										safeFirePrompt(p)
									end
								end
							end
						end
					end
				end)
			end
		end
	end)

	-- ===================== SKIP CUTSCENES =====================
	task.spawn(function()
		while task.wait(0.6) do
			if Toggles.SkipCutscenes and Toggles.SkipCutscenes.Value then
				pcall(function()
					for _, obj in ipairs(workspace:GetDescendants()) do
						local n = string.lower(obj.Name)
						if string.find(n, "cutscene") or string.find(n, "intro") or string.find(n, "cinematic") then
							obj:Destroy()
						end
					end
					if workspace.CurrentCamera then
						workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
					end
				end)
			end
		end
	end)

	-- ===================== DOOR BYPASS =====================
	task.spawn(function()
		while task.wait(0.3) do
			if Toggles.DoorBypass and Toggles.DoorBypass.Value then
				for _, d in ipairs(State.DoorList) do
					pcall(function()
						if d:IsA("BasePart") then d.CanCollide = false end
						for _, c in ipairs(d:GetDescendants()) do
							if c:IsA("BasePart") then c.CanCollide = false end
							if c:IsA("ProximityPrompt") then
								c.Enabled = true
								c.HoldDuration = 0
								c.MaxActivationDistance = 45
							end
						end
					end)
				end
			end
		end
	end)

	-- ===================== ANTI ENTITY =====================
	local KillList = {
		"Rush", "Ambush", "Seek", "Figure", "Screech", "Eyes", "Halt", "Dupe", "Hide",
		"Timothy", "Jack", "Shadow", "Void", "Snare", "Dread", "Sally", "Window",
		"Giggle", "Gloombats", "Grumble", "Queen Grumble", "Louie", "Dam Seek",
		"Blitz", "Haste", "Lookman", "A-60", "A-90", "A-120", "A60", "A90", "A120",
		"The Groundskeeper", "Mandrake", "Monument", "Eyestalk", "Bramble", "Surge", "Caw", "Grampy", "The World Lotus",
		"Honcho", "Alma", "Teller", "Ransom", "Drones", "Bash", "Scribbles", "Forget-Me-Not",
		"Portrait", "Fih", "Creak", "Noise", "Stem", "Cobbler", "Meld", "Hijack",
		"The Unnamed Red Light", "Glitch",
		"RushMoving", "AmbushMoving", "SeekMoving", "FigureRig",
	}

	local OptionalKill = {
		Jeff = "AntiJeff",
		["El Goblino"] = "AntiElGoblino",
		Bob = "AntiBob",
		["Guiding Light"] = "AntiGuidingLight",
		["Curious Light"] = "AntiCuriousLight",
	}

	local function shouldKill(name)
		if not (Toggles.AntiAll and Toggles.AntiAll.Value) then return false end
		for _, n in ipairs(KillList) do
			if name == n then return true end
		end
		for realName, toggleName in pairs(OptionalKill) do
			if name == realName and Toggles[toggleName] and Toggles[toggleName].Value then
				return true
			end
		end
		return false
	end

	local function neutralize(obj)
		pcall(function()
			obj:Destroy()
		end)
		pcall(function()
			if obj.Parent then obj.Parent = nil end
			for _, c in ipairs(obj:GetDescendants()) do
				if c:IsA("BasePart") then
					c.CanCollide = false
					c.Transparency = 1
				end
				if c:IsA("Sound") then
					c:Stop()
					c.Volume = 0
				end
			end
		end)
	end

	local function findNearestCloset()
		local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if not root then return nil end
		local closest, dist = nil, 45
		for _, obj in ipairs(workspace:GetDescendants()) do
			local n = string.lower(obj.Name)
			if string.find(n, "closet") or string.find(n, "wardrobe") or string.find(n, "cabinet") or string.find(n, "locker") then
				local part = obj:IsA("BasePart") and obj or obj:FindFirstChildWhichIsA("BasePart", true)
				if part then
					local d = (part.Position - root.Position).Magnitude
					if d < dist then
						closest = obj
						dist = d
					end
				end
			end
		end
		return closest
	end

	local function forceHide()
		local closet = findNearestCloset()
		if not closet then return end
		local prompt = closet:FindFirstChildWhichIsA("ProximityPrompt", true)
		if prompt then
			prompt.HoldDuration = 0
			safeFirePrompt(prompt)
		end
		local part = closet:IsA("BasePart") and closet or closet:FindFirstChildWhichIsA("BasePart", true)
		local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if part and root then
			pcall(function()
				root.CFrame = part.CFrame + Vector3.new(0, 1.5, 0)
			end)
		end
	end

	local lastNotify = 0
	task.spawn(function()
		while task.wait(0.12) do
			State.EntityList = {}
			if Toggles.AntiAll and Toggles.AntiAll.Value then
				pcall(function()
					for _, obj in ipairs(workspace:GetDescendants()) do
						if shouldKill(obj.Name) then
							table.insert(State.EntityList, obj)

							if Toggles.EntityNotify and Toggles.EntityNotify.Value and tick() - lastNotify > 1.8 then
								Library:Notify("Entity: " .. obj.Name, 2)
								lastNotify = tick()
							end

							if Toggles.AutoHide and Toggles.AutoHide.Value then
								if obj.Name == "Rush" or obj.Name == "Ambush" or obj.Name == "RushMoving" or obj.Name == "AmbushMoving" then
									forceHide()
								end
							end

							if Toggles.AntiLag and Toggles.AntiLag.Value then
								for _, s in ipairs(obj:GetDescendants()) do
									if s:IsA("Sound") then
										s.Volume = 0
										s:Stop()
									end
								end
							end

							neutralize(obj)
						end
					end
				end)
			end
		end
	end)

	-- character respawn support
	LP.CharacterAdded:Connect(function(char)
		task.wait(0.5)
		pcall(function()
			local hum = char:WaitForChild("Humanoid", 5)
			if hum and Options.WalkSpeed then
				hum.WalkSpeed = Options.WalkSpeed.Value
				hum.UseJumpPower = true
				if Options.JumpPower then
					hum.JumpPower = Options.JumpPower.Value
				end
			end
		end)
	end)

	-- first scan
	task.delay(1.5, function()
		refreshLists()
	end)

	Library:Notify("NIXUS loaded successfully", 4)
	print("[NIXUS] executed clean")
end)

if not success then
	warn("[NIXUS] load error:", err)
	print("[NIXUS] failed →", err)
end
